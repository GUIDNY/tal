// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  lead
  tentative
  confirmed
  completed
  cancelled
}

model Customer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fullName  String
  phone     String   @unique
  email     String?
  notes     String?
  events    Event[]
}

model Event {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  title       String? // used when there's no linked customer, e.g. "לא זמין — חופשה"
  eventType   String?
  eventDate   DateTime?   @db.Date
  venue       String?
  city        String?
  guestCount  String?
  serviceType String?
  message     String?
  status      EventStatus @default(lead)
  source      String      @default("website")
  externalId  String?     @unique // iCloud calendar UID (+ date, for multi-day events), used to dedupe on re-sync
  color       String?     // hex color of the source iCloud calendar, for icloud-sourced events

  @@index([status])
  @@index([eventDate])
  @@index([customerId])
}
