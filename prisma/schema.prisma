// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  lead
  tentative
  confirmed
  completed
  cancelled
}

enum SupplierStatus {
  active
  pending
  inactive
}

model Supplier {
  id        String         @id @default(uuid())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  fullName  String
  phone     String
  role      String? // מי זה — לדוגמה "צלם", "טכנאי סאונד"
  status    SupplierStatus @default(active)

  @@index([status])
}

model Customer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fullName  String
  phone     String   @unique
  email     String?
  notes     String?
  events    Event[]
}

model Event {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  title       String? // used when there's no linked customer, e.g. "לא זמין — חופשה"
  eventType   String?
  eventDate   DateTime?   @db.Date
  venue       String?
  city        String?
  guestCount  String?
  serviceType String?
  message     String?
  status      EventStatus @default(lead)
  source      String      @default("website")
  externalId  String?     @unique // iCloud calendar UID (+ date, for multi-day events), used to dedupe on re-sync
  color       String?     // hex color of the source iCloud calendar, for icloud-sourced events

  // Deal / pipeline tracking
  price              Int? // total deal value, ₪
  vatAmount          Int? // מע"מ, ₪
  commissionPercent  Float? // אחוז עמלה
  closingProbability Int? // 0-100, כמה קרובים לסגירה
  closedBy           String? // מי סגר את העסקה

  // Follow-up / call tracking
  nextFollowUpDate DateTime? @db.Date // מתי השיחה/המעקב הבא
  lastContactedAt  DateTime? // מתי דיברנו לאחרונה
  contactedBy      String? // מי דיבר עם הליד
  callNotes        String? // סיכום שיחה

  @@index([status])
  @@index([eventDate])
  @@index([customerId])
  @@index([nextFollowUpDate])
}
